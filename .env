# Nextcloud instance URL (no trailing slash)
NEXTCLOUD_BASE=https://your-nextcloud.example.com

# Nextcloud username
NEXTCLOUD_USER=your_username

# Nextcloud App Password (Settings > Security > Devices & sessions > App passwords)
NEXTCLOUD_PASS=your_app_password

# Calendars to sync — comma-separated list of "caldav-name|ical-url[|emoji]" entries.
# "caldav-name" must match the exact name of an existing calendar in Nextcloud.
# "ical-url"    is the public or private URL of the .ics feed to import.
# "emoji"       (optional) is prepended to every event's title on import.
#
# Example with multiple calendars:
# CALENDARS=work|https://calendar.google.com/calendar/ical/xxx/basic.ics|💼,holidays|https://www.example.com/holidays.ics|🎉
CALENDARS=my-calendar|https://example.com/feed.ics
