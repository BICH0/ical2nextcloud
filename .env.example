# ── Single-user format (legacy) ───────────────────────────────────────────────
# NEXTCLOUD_BASE=https://your-nextcloud.example.com
# NEXTCLOUD_USER=your_username
# NEXTCLOUD_PASS=your_app_password
# CALENDARS=my-calendar|https://example.com/feed.ics|🗓️

# ── Multi-user format ──────────────────────────────────────────────────────────
# Each user is defined with a USER_N_ prefix (N = 1, 2, 3, ...).
# Users can belong to the same or different Nextcloud instances.
#
# USER_1_BASE=https://your-nextcloud.example.com
# USER_1_USER=alice
# USER_1_PASS=alice_app_password
# USER_1_CALENDARS=work|https://example.com/work.ics|💼,holidays|https://example.com/holidays.ics|🎉
#
# USER_2_BASE=https://your-nextcloud.example.com
# USER_2_USER=bob
# USER_2_PASS=bob_app_password
# USER_2_CALENDARS=personal|https://example.com/personal.ics

# ── CALENDARS format ───────────────────────────────────────────────────────────
# Comma-separated list of "caldav-name|ical-url[|emoji]" entries.
# "caldav-name" must match the exact name of an existing calendar in Nextcloud.
# "ical-url"    is the public or private URL of the .ics feed to import.
# "emoji"       (optional) is prepended to every event's title on import.
#               Can be a literal emoji or a Unicode escape: \U0001F4C5

NEXTCLOUD_BASE=https://your-nextcloud.example.com
NEXTCLOUD_USER=your_username
NEXTCLOUD_PASS=your_app_password
CALENDARS=my-calendar|https://example.com/feed.ics
